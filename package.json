{
  "name": "extended-clipboard",
  "productName": "Extended Clipboard",
  "version": "0.1.0",
  "description": "A modern desktop application for intelligent clipboard management with auto-monitoring, search, filtering, and organization features.",
  "author": "Daniel Freer <djfreer@icloud.com>",
  "license": "MIT",
  "main": "dist/main/main.js",
  "scripts": {
    "start": "electron .",
    "build:main": "tsc -p tsconfig.main.json",
    "watch:main": "tsc -p tsconfig.main.json --watch",
    "dev:renderer": "vite --port 5174 --strictPort",
    "start:electron": "cross-env NODE_ENV=development wait-on dist/main/main.js http://localhost:5174 && electronmon .",
    "dev": "concurrently -k \"npm:watch:main\" \"npm:dev:renderer\" \"npm:start:electron\"",
    "build": "npm run build:main && vite build",
    "build:web": "cross-env VITE_BUILD_TARGET=web vite build",
    "preview:web": "cross-env VITE_BUILD_TARGET=web vite preview",
    "pack": "electron-builder --dir",
    "dist": "npm run build && electron-builder",
    "dist:mac": "npm run build && electron-builder --mac",
    "dist:win": "npm run build && electron-builder --win",
    "dist:linux": "npm run build && electron-builder --linux",
    "dist:all": "npm run dist:mac && npm run dist:win && npm run dist:linux",
    "prepare-release": "./scripts/upload-release.sh",
    "test": "vitest run --reporter=dot",
    "test:watch": "vitest",
    "coverage": "vitest run --coverage"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.0.1",
    "@types/react": "^19.1.9",
    "@types/react-dom": "^19.1.7",
    "@types/testing-library__jest-dom": "^6.0.0",
    "@vitest/coverage-v8": "^3.2.4",
    "concurrently": "^8.2.0",
    "cross-env": "^10.0.0",
    "electron": "^28.0.0",
    "electron-builder": "^26.0.12",
    "electronmon": "^2.0.3",
    "jsdom": "^26.1.0",
    "sass": "^1.77.0",
    "typescript": "^5.3.0",
    "vite": "^7.1.1",
    "vitest": "^3.2.4",
    "wait-on": "^8.0.4"
  },
  "dependencies": {
    "date-fns": "^4.1.0",
    "react": "^19.1.1",
    "react-dom": "^19.1.1"
  },
  "build": {
    "appId": "com.djfreer.extended-clipboard",
    "productName": "Extended Clipboard",
    "directories": {
      "buildResources": "assets",
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "node_modules/**/*",
      "package.json"
    ],
    "mac": {
      "icon": "src/assets/app_icon/Extended Clipboard_App_Icon.png",
      "category": "public.app-category.productivity",
      "target": [
        {
          "target": "dmg",
          "arch": ["x64", "arm64"]
        },
        {
          "target": "zip",
          "arch": ["x64", "arm64"]
        }
      ]
    },
    "win": {
      "icon": "src/assets/app_icon/Extended Clipboard_App_Icon.png",
      "target": [
        {
          "target": "nsis",
          "arch": ["x64"]
        },
        {
          "target": "portable",
          "arch": ["x64"]
        }
      ]
    },
    "linux": {
      "icon": "src/assets/app_icon/Extended Clipboard_App_Icon.png",
      "category": "Utility",
      "target": [
        {
          "target": "AppImage",
          "arch": ["x64"]
        },
        {
          "target": "deb",
          "arch": ["x64"]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    }
  }
}
